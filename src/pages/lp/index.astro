        </div>
      </div>
    </section>

    <!-- 7. Seção Final: Localização & Mapa Integrado do Google Maps -->
    <section class="lp-map-section" id="localizacao">
      <div class="container">
        <div class="lp-section-title-wrap">
          <span class="lp-kicker">Visite Nosso Depósito</span>
          <h2 class="lp-section-heading">Pátio e Loja Física em Jacarepaguá</h2>
