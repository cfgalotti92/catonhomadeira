        </div>

        <div class="lp-map-split">
          <!-- Card de Contatos & Telefones -->
          <div class="lp-store-details-card">
            <h3 class="store-name">Catonho Madeiras</h3>
            
            <p class="store-address-p">
              📍 <strong>Estrada do Catonho, 1205</strong><br />
              Tanque / Jacarepaguá — Rio de Janeiro - RJ<br />
              CEP 22723-013 (Acesso rápido pela Transolímpica e Sulacap)
