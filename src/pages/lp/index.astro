            </div>

            <div class="store-phones-grid">
              <strong>Ligue para nossos telefones:</strong>
              <div class="phones-button-list">
                <a href="tel:2124351454" class="btn lp-phone-btn">📞 (21) 2435-1454</a>
                <a href="tel:2124234425" class="btn lp-phone-btn">📞 (21) 2423-4425</a>
                <a href="tel:2124234401" class="btn lp-phone-btn">📞 (21) 2423-4401</a>
                <a href="https://wa.me/5521979011647" target="_blank" rel="noopener noreferrer" class="btn lp-phone-btn lp-phone-btn-wa">
                  💬 WhatsApp: (21) 97901-1647
                </a>
              </div>
            </div>

            <a
              href="https://www.google.com/maps/dir/?api=1&destination=Estrada+do+Catonho+1205+Jacarepagua+Rio+de+Janeiro+RJ"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary lp-btn-gps"
            >
              <span>Abrir Rota no Google Maps / GPS</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <!-- Mapa Integrado do Google Maps -->
          <div class="lp-map-embed-card">
