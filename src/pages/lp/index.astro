---
// src/pages/lp/index.astro
// Landing Page de Alta Conversão para Google Ads (Tráfego Pago /lptrafegopago)
// Arquitetura Direta: Atenção -> Oferta Clara -> Produtos -> Confiança/Selo -> Mapa/Localização
import SEOHead from '../../components/seo/SEOHead.astro';
import '../../styles/global.css';

const productCategories = [
  {
    title: 'Vigas de Maçaranduba (Paraju)',
    desc: 'Bitolas 14x6, 15x5, 20x7 e 30x7 cm. Peças brutas e aparelhadas para estruturas de alta resistência.',
    image: '/images/products/madeiras/viga-macaranduba-bruta.jpg',
    imageAlt: 'Vigas de maçaranduba bruta para telhado',
    badge: 'Mais Vendido',
    msg: 'Olá! Vim pelo Google e gostaria de cotar Vigas de Maçaranduba.'
  },
  {
    title: 'Caibros e Ripas Aparelhadas',
    desc: 'Caibros 6x3,5 cm e ripas 5x1,5 cm de Maçaranduba com alinhamento perfeito para montagem de telhados.',
    image: '/images/products/madeiras/caibro-macaranduba.png',
    imageAlt: 'Caibros de maçaranduba aparelhados para telhado',
    badge: 'Pronta Entrega',
    msg: 'Olá! Gostaria de cotar Caibros e Ripas para meu telhado.'
  },
  {
    title: 'Telhas Coloniais & Esmaltadas',
    desc: 'Capa e bica (40, 47, 50 e 57cm), romanas, portuguesas e esmaltadas vitrificadas sem proliferação de limo.',
    image: '/images/products/telhas/telha-capa-e-bica.jpg',
    imageAlt: 'Telha cerâmica colonial capa e bica',
    badge: 'Preço Direto',
    msg: 'Olá! Gostaria de cotar Telhas Coloniais e Esmaltadas.'
  },
  {
    title: 'Portas de Madeira Maciça',
    desc: 'Modelos pivotantes, em lambri diagonal e frisadas em Tauari e Angelim com caixonetes sob medida.',
    image: '/images/products/portas/porta-macica-tauari-lambri.jpg',
    imageAlt: 'Porta maciça tauari lambri diagonal',
    badge: 'Sob Medida',
    msg: 'Olá! Gostaria de cotar Portas Maciças e Esquadrias.'
  },
  {
    title: 'Deck de Cumaru Extra (Piscina)',
    desc: 'Pranchas nobres aparelhadas e boleadas para decks de piscina, varandas gourmet e pergolados.',
    image: '/images/products/madeiras/deck-cumaru.png',
    imageAlt: 'Pranchas de deck de cumaru aparelhado',
    badge: 'Qualidade Premium',
    msg: 'Olá! Gostaria de cotar Deck de Cumaru para minha área externa.'
  },
  {
    title: 'Churrasqueiras Pré-Moldadas',
    desc: 'Concreto refratário com acabamento tijolinho, coifa, dutos prolongadores e bancadas.',
    image: '/images/products/churrasqueiras/churrasqueira-pre-moldada-tijolinho.png',
    imageAlt: 'Churrasqueira pré-moldada refratária para área gourmet',
    badge: 'Área Gourmet',
    msg: 'Olá! Gostaria de cotar Churrasqueira Pré-Moldada.'
  }
];

const steps = [
  {
    num: '1',
    title: 'Envie sua Lista no WhatsApp',
    desc: 'Mande os itens, bitolas e metragens da sua obra ou a foto do seu projeto.'
  },
  {
    num: '2',
    title: 'Receba o Cálculo em 10 Min',
    desc: 'Nossos técnicos calculam as peças exatas com frete e prazo para sua região.'
  },
  {
    num: '3',
    title: 'Pague na Entrega da Carga',
    desc: 'Descarregamos no seu canteiro e você paga com cartão, Pix ou faturado.'
  }
];

const faqs = [
  {
    q: 'Qual o tempo de resposta do orçamento?',
    a: 'Nosso atendimento comercial responde em menos de 10 minutos pelo WhatsApp de segunda a sexta das 08h às 18h e aos sábados das 08h às 12h.'
  },
  {
    q: 'Vocês entregam em todo o Rio de Janeiro?',
    a: 'Sim. Temos frota própria de caminhões com entregas diárias na Zona Oeste (Jacarepaguá, Barra da Tijuca, Recreio, Taquara, Vargens), Zona Norte, Sulacap, Valqueire e Grande Rio.'
  },
  {
    q: 'As madeiras têm nota fiscal e garantia de origem?',
    a: '100% das madeiras de lei comercializadas possuem Documento de Origem Florestal (DOF) e Nota Fiscal, garantindo procedência legal, peças retas e secas.'
  },
  {
    q: 'Posso retirar o material direto no depósito?',
    a: 'Sim! Nosso pátio fica na Estrada do Catonho, 1205 (Jacarepaguá), com amplo estacionamento e carregamento imediato de peças.'
  }
];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SEOHead
      title="Madeiras para Telhado & Telhas no Rio | Catonho Madeiras (Orçamento Rápido)"
      description="Depósito de madeiras para telhado e telhas em Jacarepaguá. Vigas de Maçaranduba, Caibros, Ripas, Telhas e Portas. Cotação em 10 min no WhatsApp (21) 97901-1647 ou Ligue (21) 2435-1454."
      noindex={false}
    />
  </head>
  <body class="lp-body">
    <!-- 1. Header Focado (Anti-Vazamento) -->
    <header class="lp-header">
      <div class="container lp-header-inner">
        <div class="lp-brand">
          <img src="/images/logo.png" alt="Logo Catonho Madeiras" width="48" height="48" class="lp-logo-img" />
          <div class="lp-brand-text">
            <span class="lp-brand-title">CATONHO MADEIRAS</span>
            <span class="lp-brand-sub">Jacarepaguá · Desde 1989</span>
          </div>
        </div>

        <div class="lp-header-actions">
          <a href="tel:2124351454" class="lp-call-header-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>(21) 2435-1454</span>
          </a>

          <a
            href="https://wa.me/5521979011647?text=Ol%C3%A1%2C%20vim%20pelo%20Google%20e%20gostaria%20de%20um%20or%C3%A7amento%20r%C3%A1pido."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp lp-wa-header-btn"
            data-cta="google_ads_lp_whatsapp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
            </svg>
            <span>WhatsApp (21) 97901-1647</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 2. Hero Section Split-Screen (Alto Impacto Visual & Conversão) -->
    <section class="lp-hero-split">
      <div class="container">
        <div class="lp-hero-row">
          <!-- Coluna 1: Proposta de Valor & Ações Imediatas -->
          <div class="lp-hero-left">
            <div class="lp-pill-kicker">
              <span class="pulse-dot" aria-hidden="true"></span>
              <span>DEPÓSITO PRÓPRIO · ENTREGA RÁPIDA NO RIO</span>
            </div>

            <h1 class="lp-main-heading">
              Madeiras para Telhado & Telhas com Preço Direto de Depósito
            </h1>

            <p class="lp-main-lead">
              Compre vigas de <strong>Maçaranduba</strong>, caibros, ripas e telhas coloniais com entrega programada em toda a Zona Oeste e Grande Rio. Envie sua lista e receba o orçamento detalhado em <strong>menos de 10 minutos</strong>.
            </p>

            <!-- Ações Principais: WhatsApp + Botões de Ligação -->
            <div class="lp-cta-action-block">
              <a
                href="https://wa.me/5521979011647?text=Ol%C3%A1%21%20Vim%20pelo%20anuncio%20do%20Google%20e%20gostaria%20de%20solicitar%20um%20or%C3%A7amento%20de%20madeiras%20e%20telhas."
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp lp-btn-primary-wa"
                data-cta="google_ads_lp_whatsapp"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
                </svg>
                <span>Solicitar Orçamento no WhatsApp</span>
              </a>

              <div class="lp-call-options">
                <span class="call-lead">Ou prefere ligar agora para o depósito?</span>
                <div class="call-buttons-inline">
                  <a href="tel:2124351454" class="btn lp-call-pill">
                    📞 (21) 2435-1454
                  </a>
                  <a href="tel:2124234425" class="btn lp-call-pill">
                    📞 (21) 2423-4425
                  </a>
                </div>
              </div>
            </div>

            <!-- Selo de Avaliação Google Integrado na Hero -->
            <div class="lp-hero-google-proof">
              <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <div class="stars-gold">★★★★★</div>
              <span class="proof-score"><strong>4.9 / 5.0</strong> no Google Meu Negócio (+100 avaliações)</span>
            </div>
          </div>

          <!-- Coluna 2: Card Visual com Estoque e Diferenciais -->
          <div class="lp-hero-right">
            <div class="lp-hero-image-card">
              <img
                src="/images/products/madeiras/viga-macaranduba-bruta.jpg"
                alt="Madeiramento nobre estrutural de maçaranduba no depósito da Catonho Madeiras"
                width="540"
                height="360"
                class="hero-card-img"
              />
              <div class="hero-card-badge-overlay">
                <strong>Pátio Próprio em Jacarepaguá</strong>
                <span>Estrada do Catonho, 1205</span>
              </div>
              <div class="hero-card-footer-stats">
                <div class="stat-box">
                  <span class="stat-val">35+</span>
                  <span class="stat-lbl">Anos de Loja</span>
                </div>
                <div class="stat-box">
                  <span class="stat-val">100%</span>
                  <span class="stat-lbl">Madeiras com DOF</span>
                </div>
                <div class="stat-box">
                  <span class="stat-val">52k+</span>
                  <span class="stat-lbl">Clientes no RJ</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Passo a Passo Rápido: Como Funciona -->
    <section class="lp-steps-section">
      <div class="container">
        <div class="lp-steps-grid">
          {steps.map((s) => (
            <div class="lp-step-item">
              <div class="step-badge">{s.num}</div>
              <div class="step-text">
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Catálogo de Produtos em Estoque com Ações Rápidas -->
    <section class="lp-catalog-section" id="produtos">
      <div class="container">
        <div class="lp-section-title-wrap">
          <span class="lp-kicker">Pronta Entrega no Pátio</span>
          <h2 class="lp-section-heading">O Que Você Precisa para Sua Obra Hoje?</h2>
          <p class="lp-section-sub">Selecione o produto desejado para falar direto com o vendedor no WhatsApp:</p>
        </div>

        <div class="lp-catalog-grid">
          {productCategories.map((item) => (
            <article class="lp-item-card">
              <div class="lp-item-img-wrap">
                <img src={item.image} alt={item.imageAlt} width="360" height="240" loading="lazy" class="lp-item-img" />
                <span class="lp-item-badge">{item.badge}</span>
              </div>
              <div class="lp-item-body">
                <h3 class="lp-item-title">{item.title}</h3>
                <p class="lp-item-desc">{item.desc}</p>
                <div class="lp-item-cta-group">
                  <a
                    href={`https://wa.me/5521979011647?text=${encodeURIComponent(item.msg)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-whatsapp lp-item-btn-wa"
                    data-cta="google_ads_lp_whatsapp"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
                    </svg>
                    <span>Cotar no WhatsApp</span>
                  </a>
                  <a href="tel:2124351454" class="btn lp-item-btn-call" title="Ligar para cotar">
                    <span>Ligar</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Selo Google 4.9 Estrelas (Seção de Autoridade & Confiança) -->
    <section class="lp-google-full-section">
      <div class="container">
        <div class="lp-google-center-box">
          <div class="google-header-inline">
            <div class="google-big-g" aria-hidden="true">
              <svg width="42" height="42" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
            <div class="google-score-meta">
              <span class="score-digit">4.9</span>
              <div class="stars-gold-big" aria-label="Avaliação 4.9 de 5 estrelas">★★★★★</div>
            </div>
          </div>

          <h2 class="google-center-title">Mais de 100 Avaliações 5 Estrelas no Google</h2>
          <p class="google-center-desc">
            A Catonho Madeiras é avaliada no Rio de Janeiro pela pontualidade de entrega, qualidade rigorosa das madeiras nobres e transparência no atendimento direto da loja física.
          </p>

          <a
            href="https://wa.me/5521979011647?text=Ol%C3%A1%2C%20gostaria%20de%20tirar%20uma%20d%C3%BAvida%20e%20pedir%20um%20or%C3%A7amento."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp lp-btn-google-talk"
            data-cta="google_ads_lp_whatsapp"
          >
            <span>Falar com Nossos Especialistas no WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Anti-Objeções -->
    <section class="lp-faq-section">
      <div class="container lp-faq-wrap">
        <div class="lp-section-title-wrap">
          <span class="lp-kicker">Dúvidas Rápidas</span>
          <h2 class="lp-section-heading">Perguntas Frequentes sobre Entregas e Pedidos</h2>
        </div>

        <div class="lp-faq-accordion">
          {faqs.map((f) => (
            <details class="lp-faq-card">
              <summary class="lp-faq-sum">
                <span>{f.q}</span>
                <span class="sum-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="lp-faq-content">
                <p>{f.a}</p>
