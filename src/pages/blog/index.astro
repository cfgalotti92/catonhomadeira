---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = Array.from(new Set(allPosts.map((post) => post.data.category)));
---

<BaseLayout
  title="Blog e Dicas Técnicas de Construção e Madeiras"
  description="Artigos especializados sobre madeira para telhado, espécies de madeira de lei, cálculo de materiais, telhas cerâmicas, esquadrias e churrasqueiras no RJ."
>
  <Breadcrumbs items={[{ label: 'Blog & Dicas Técnicas' }]} />

  <!-- Blog Header -->
  <header class="blog-hero section-py">
    <div class="container container-narrow">
      <div class="badge">Centro Editorial & Técnico</div>
      <h1 class="blog-hero-title">Blog Catonho Madeiras</h1>
      <p class="blog-hero-desc">
        Guias práticos, comparativos de espécies e orientações técnicas de carpintaria e coberturas preparados pela equipe com mais de 35 anos de tradição em Jacarepaguá.
      </p>

      <!-- Category Filter Pills -->
      <div class="category-pills">
        <span class="pill-label">Categorias:</span>
        <span class="pill is-active">Todos os Artigos ({allPosts.length})</span>
        {categories.map((cat) => (
          <span class="pill">{cat}</span>
        ))}
      </div>
    </div>
  </header>

  <!-- Blog Grid -->
  <section class="blog-grid-section">
    <div class="container">
      <div class="blog-posts-grid">
        {sortedPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            pubDate={post.data.pubDate}
            category={post.data.category}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- WhatsApp Consultation CTA -->
  <WhatsAppCTA
    title="Ficou com alguma dúvida técnica sobre seu projeto?"
    subtitle="Converse diretamente com a equipe da Catonho Madeiras pelo WhatsApp. Ajudamos a calcular suas vigas, telhas ou esquadrias."
    buttonText="Tirar Dúvidas com Especialista"
    defaultMessage="Olá! Estava lendo o blog da Catonho Madeiras e gostaria de tirar uma dúvida sobre materiais para minha obra."
  />
</BaseLayout>

<style>
  .blog-hero {
    background-color: var(--color-paper-subtle);
    border-bottom: 1px solid var(--color-border-hairline);
    text-align: center;
  }

  .blog-hero-title {
    font-size: var(--text-4xl);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .blog-hero-desc {
    font-size: var(--text-lg);
    color: var(--color-ink-secondary);
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .pill-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .pill {
    padding: 6px 14px;
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--radius-full);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    color: var(--color-ink-secondary);
  }

  .pill.is-active {
    background-color: var(--color-paper-dark);
    color: var(--color-ink-inverse);
    border-color: var(--color-paper-dark);
    font-weight: 600;
  }

  /* Grid */
  .blog-grid-section {
    padding-block: var(--space-12);
  }

  .blog-posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .blog-posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .blog-posts-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
