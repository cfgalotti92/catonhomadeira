---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import ProductGrid from '../../components/ui/ProductGrid.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';

const lockProducts = [
  {
    name: 'Fechadura Externa de Segurança com Roseta',
    category: 'Fechaduras Externas',
    speciesOrMaterial: 'Aço Inox / Latão',
    finishOrType: 'Cromado / Roseta Quadrada',
    dimensions: 'Broca 40 e 55 mm',
    image: '/images/products/fechaduras/fechadura-externa-roseta.jpg',
    imageAlt: 'Fechadura externa cromada com cilindro de alta segurança e roseta',
    badge: 'Segurança'
  },
  {
    name: 'Puxador Cilíndrico em Aço Inox',
    category: 'Puxadores para Portas',
    speciesOrMaterial: 'Aço Inox Escovado / Polido',
    finishOrType: 'Cilíndrico Duplo (Interno e Externo)',
    dimensions: 'Comprimento 40 / 60 / 80 cm',
    image: '/images/products/fechaduras/puxador-cilindrico-inox.jpg',
    imageAlt: 'Puxador cilíndrico de aço inox para portas de madeira pivotantes'
  }
];

const fechadurasFAQs = [
  {
    question: 'Qual a diferença entre fechadura externa, interna e de banheiro?',
    answer: 'A fechadura externa possui cilindro com chave segredo (para maior proteção contra invasões). A fechadura interna utiliza chave comum simples para quartos. A fechadura de banheiro (WC) possui trinco com abertura de emergência externa sem necessidade de chave.'
  },
  {
    question: 'Puxadores em inox podem ser instalados em portas maciças e pivotantes?',
    answer: 'Sim! Os puxadores cilíndricos de inox são ideais para portas maciças e pivotantes de entrada, pois oferecem pegada confortável e alta resistência à maresia e intempéries.'
  }
];
---

<BaseLayout
  title="Fechaduras e Puxadores para Portas em Jacarepaguá RJ"
  description="Fechaduras de segurança externas, fechaduras de quarto e banheiro, e puxadores em aço inox na Estrada do Catonho, 1205. Catonho Madeiras."
>
  <Breadcrumbs items={[{ label: 'Fechaduras & Puxadores' }]} />

  <!-- Hero -->
  <header class="cat-hero section-py">
    <div class="container">
      <div class="cat-hero-grid">
        <div class="cat-hero-text">
          <div class="badge">Segurança & Acabamento · Jacarepaguá</div>
          <h1 class="cat-hero-title">Fechaduras de Segurança e Puxadores em Inox no RJ</h1>
          <p class="cat-hero-desc">
            Acabamentos nobres para suas portas de madeira. Fechaduras externas com cilindro reforçado, modelos para quartos e banheiros, e puxadores modernos em aço inox escovado e polido.
          </p>
          <div class="cat-hero-actions">
            <a
              href="https://wa.me/5521979011647?text=Ol%C3%A1!%20Gostaria%20de%20consultar%20fechaduras%20e%20puxadores%20para%20portas."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
              </svg>
              <span>Consultar Fechaduras no WhatsApp</span>
            </a>
            <a href="#catalogo-fechaduras" class="btn btn-secondary">Ver Modelos</a>
          </div>
        </div>
        <div class="cat-hero-spec-box">
          <h2 class="spec-box-title">Destaques da Categoria</h2>
          <ul class="spec-box-list">
            <li><strong>Fechaduras Externas:</strong> Alta segurança com cilindro e chaves segredo.</li>
            <li><strong>Puxadores Inox:</strong> Tamanhos de 40 a 80cm para portas pivotantes.</li>
            <li><strong>Fechaduras de Banheiro (WC):</strong> Trinco seguro com abertura de emergência.</li>
            <li><strong>Rosetas e Espelhos:</strong> Acabamentos quadrado e redondo cromados.</li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <!-- Catalog -->
  <section class="section-py" id="catalogo-fechaduras" aria-labelledby="catalog-locks-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="catalog-locks-heading" class="section-title">Catálogo de Fechaduras & Puxadores</h2>
        <p class="section-desc">
          Mecanismos duráveis de alta resistência à corrosão e funcionamento suave.
        </p>
      </div>

      <ProductGrid columns={3}>
        {lockProducts.map((prod) => (
          <ProductCard
            name={prod.name}
            category={prod.category}
            speciesOrMaterial={prod.speciesOrMaterial}
            finishOrType={prod.finishOrType}
            dimensions={prod.dimensions}
            image={prod.image}
            imageAlt={prod.imageAlt}
            badge={prod.badge}
          />
        ))}
      </ProductGrid>
    </div>
  </section>

  <!-- WhatsApp CTA -->
  <WhatsAppCTA
    title="Compre suas portas e fechaduras em um só lugar"
    subtitle="Garanta a compatibilidade perfeita entre a folha da porta, a aduela e a fechadura comprando seu kit completo na Catonho Madeiras."
    buttonText="Pedir Orçamento de Kit Completo"
    defaultMessage="Olá! Gostaria de consultar os kits de portas com fechaduras na Catonho Madeiras."
  />

  <!-- FAQs -->
  <FAQAccordion items={fechadurasFAQs} title="Dúvidas Frequentes sobre Fechaduras" />
</BaseLayout>

<style>
  .cat-hero {
    background-color: var(--color-paper-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .cat-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 900px) {
    .cat-hero-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-10);
    }
  }

  .cat-hero-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .cat-hero-title {
      font-size: var(--text-4xl);
    }
  }

  .cat-hero-desc {
    font-size: var(--text-base);
    color: var(--color-ink-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .cat-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .cat-hero-spec-box {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  .spec-box-title {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    margin-top: 0;
    margin-bottom: var(--space-3);
    color: var(--color-ink-primary);
  }

  .spec-box-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
  }

  .spec-box-list li strong {
    color: var(--color-ink-primary);
  }
</style>
