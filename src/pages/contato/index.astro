---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import StoreLocation from '../../components/ui/StoreLocation.astro';
import WhatsAppCTA from '../../components/ui/WhatsAppCTA.astro';
---

<BaseLayout
  title="Contato e Endereço da Catonho Madeiras em Jacarepaguá RJ"
  description="Telefones, WhatsApp, horário de funcionamento e localização da Catonho Madeiras na Estrada do Catonho, 1205, Jacarepaguá, Rio de Janeiro."
>
  <Breadcrumbs items={[{ label: 'Contato & Localização' }]} />

  <!-- Hero -->
  <header class="contact-hero section-py">
    <div class="container container-narrow text-center">
      <div class="badge">Fale com a Nossa Equipe</div>
      <h1 class="contact-hero-title">Canais de Atendimento e Localização</h1>
      <p class="contact-hero-desc">
        Estamos à disposição para tirar dúvidas, calcular quantitativos de madeira e telhas, ou receber você pessoalmente no nosso pátio em Jacarepaguá.
      </p>
    </div>
  </header>

  <!-- Contact Cards Grid -->
  <section class="section-py contact-cards-section">
    <div class="container">
      <div class="contact-grid">
        <!-- WhatsApp Card -->
        <div class="contact-card">
          <div class="contact-card-icon whatsapp-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
            </svg>
          </div>
          <h2 class="contact-card-title">WhatsApp Comercial</h2>
          <p class="contact-card-text">Canal mais rápido para envio de listas de corte e orçamentos.</p>
          <a
            href="https://wa.me/5521979011647?text=Ol%C3%A1!%20Gostaria%20de%20um%20atendimento."
            target="_blank"
            rel="noopener noreferrer"
            class="contact-card-link whatsapp-color"
          >
            (21) 97901-1647
          </a>
        </div>

        <!-- Telefone Fixo Card -->
        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h2 class="contact-card-title">Telefones Fixos</h2>
          <p class="contact-card-text">Ligue para o nosso balcão de vendas na loja:</p>
          <div class="phone-list">
            <a href="tel:2124351454" class="contact-card-link">(21) 2435-1454</a>
            <a href="tel:2124234425" class="contact-card-link">(21) 2423-4425</a>
            <a href="tel:2124234401" class="contact-card-link">(21) 2423-4401</a>
          </div>
        </div>

        <!-- E-mail Card -->
        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <h2 class="contact-card-title">E-mail</h2>
          <p class="contact-card-text">Envio de plantas, cadastros de construtoras e faturamento:</p>
          <a href="mailto:catonhomadeiras@hotmail.com" class="contact-card-link">
            catonhomadeiras@hotmail.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Store Location Section -->
  <StoreLocation
    title="Pátio & Loja na Estrada do Catonho"
    subtitle="Acesso facilitado entre Jacarepaguá, Sulacap e Barra da Tijuca. Estacionamento no local."
  />

  <!-- CTA -->
  <WhatsAppCTA />
</BaseLayout>

<style>
  .contact-hero {
    background-color: var(--color-paper-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .text-center {
    text-align: center;
  }

  .contact-hero-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .contact-hero-title {
      font-size: var(--text-4xl);
    }
  }

  .contact-hero-desc {
    font-size: var(--text-base);
    color: var(--color-ink-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Cards */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-card {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-card-icon {
    width: 48px;
    height: 48px;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .whatsapp-icon {
    background-color: var(--color-whatsapp-surface);
    color: var(--color-whatsapp);
  }

  .contact-card-title {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .contact-card-text {
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    line-height: 1.4;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .contact-card-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-primary);
    text-decoration: none;
  }

  .contact-card-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .whatsapp-color {
    color: var(--color-whatsapp) !important;
    font-size: var(--text-base);
  }

  .phone-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
