---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentSlug: string;
  category: string;
  allPosts: CollectionEntry<'blog'>[];
}

const { currentSlug, category, allPosts } = Astro.props;

// Filter posts: matching category first, then others, excluding current
const relatedPosts = allPosts
  .filter((post) => post.id !== currentSlug)
  .sort((a, b) => {
    if (a.data.category === category && b.data.category !== category) return -1;
    if (a.data.category !== category && b.data.category === category) return 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 2);
---

{relatedPosts.length > 0 && (
  <section class="compact-related-section" aria-labelledby="related-heading">
    <div class="compact-related-header">
      <h3 id="related-heading" class="compact-related-title">Continue Lendo no Blog</h3>
      <a href="/blog/" class="compact-all-link">Ver todos os artigos →</a>
    </div>

    <div class="compact-related-grid">
      {relatedPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="compact-post-card">
          <div class="compact-post-thumb-wrap">
            <img
              src={post.data.image}
              alt={post.data.imageAlt}
              width="100"
              height="70"
              loading="lazy"
              class="compact-post-thumb"
            />
          </div>
          <div class="compact-post-info">
            <div class="compact-post-meta">
              <span class="compact-cat-badge">{post.data.category}</span>
              <span class="compact-time">· {post.data.readingTime}</span>
            </div>
            <h4 class="compact-post-title">{post.data.title}</h4>
            <span class="compact-read-cta">Ler artigo →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .compact-related-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-hairline);
  }

  .compact-related-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
  }

  .compact-related-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink-primary);
    margin: 0;
  }

  .compact-all-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .compact-all-link:hover {
    text-decoration: underline;
  }

  .compact-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .compact-related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  .compact-post-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 10px;
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .compact-post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .compact-post-thumb-wrap {
    width: 90px;
    height: 65px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-paper-muted);
  }

  .compact-post-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .compact-post-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .compact-post-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.6875rem;
  }

  .compact-cat-badge {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .compact-time {
    color: var(--color-ink-muted);
  }

  .compact-post-title {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .compact-read-cta {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 2px;
  }
</style>
