---
interface Props {
  category: string;
  customTitle?: string;
  customText?: string;
  categoryLink?: string;
  categoryLinkText?: string;
}

const {
  category,
  customTitle,
  customText,
  categoryLink,
  categoryLinkText
} = Astro.props;

// Mapeamento contextual refinado por categoria
let defaultTitle = 'Vai Comprar Madeiras para sua Obra ou Telhado?';
let defaultText = 'Trabalhamos com madeiras de lei nobres (Maçaranduba, Cumaru e Angelim) selecionadas, secas e com DOF legal. Envie sua lista de peças ou medidas e receba o orçamento com frete no WhatsApp em menos de 10 minutos.';
let defaultCatLink = '/madeiras/';
let defaultCatText = 'Ver Catálogo de Madeiras';

const catLower = category.toLowerCase();

if (catLower.includes('telha') || catLower.includes('cobertura')) {
  defaultTitle = 'Planejando a Cobertura da sua Casa no Rio?';
  defaultText = 'Temos estoque completo de telhas coloniais capa e bica (40 a 57cm), telhas esmaltadas vitrificadas e cumeeiras para pronta entrega em Jacarepaguá e Grande Rio.';
  defaultCatLink = '/telhas/';
  defaultCatText = 'Ver Modelos de Telhas';
} else if (catLower.includes('porta') || catLower.includes('janela') || catLower.includes('esquadria')) {
  defaultTitle = 'Procurando Portas ou Janelas de Madeira Maciça?';
  defaultText = 'Trabalhamos com portas pivotantes, maciças e pranchetas, além de janelas coloniais, maxim-ar e caixonetes em Tauari e Angelim sob medida.';
  defaultCatLink = '/portas/';
  defaultCatText = 'Ver Portas de Madeira';
} else if (catLower.includes('churrasqueira') || catLower.includes('lazer') || catLower.includes('deck') || catLower.includes('pergolado')) {
  defaultTitle = 'Construindo sua Área Gourmet, Deck ou Pergolado?';
  defaultText = 'Pranchas de Deck de Cumaru nobre, vigas aparelhadas para pergolados e churrasqueiras pré-moldadas completas para sua área de lazer no Rio.';
  defaultCatLink = '/churrasqueiras/';
  defaultCatText = 'Ver Linha para Área Gourmet';
} else if (catLower.includes('cuidado') || catLower.includes('manuten')) {
  defaultTitle = 'Precisa de Madeiras Tratadas e Imunizadas para sua Obra?';
  defaultText = 'Fornecemos madeiras selecionadas de alto cerne imunes a cupins e orientamos você sobre os melhores produtos protetores e vernizes para o clima do RJ.';
  defaultCatLink = '/madeiras/';
  defaultCatText = 'Conhecer Madeiras de Lei';
}

const finalTitle = customTitle || defaultTitle;
const finalText = customText || defaultText;
const finalCatLink = categoryLink || defaultCatLink;
const finalCatText = categoryLinkText || defaultCatText;

const whatsappMessage = encodeURIComponent(`Olá! Li o artigo no blog da Catonho Madeiras sobre ${category} e gostaria de solicitar um orçamento para meu projeto.`);
const whatsappUrl = `https://wa.me/5521979011647?text=${whatsappMessage}`;
---

<aside class="article-cta-box" aria-labelledby="article-cta-heading">
  <div class="article-cta-top">
    <span class="article-cta-badge">ATENDIMENTO CATONHO MADEIRAS</span>
    <span class="article-cta-status">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>Orçamento Rápido Online</span>
    </span>
  </div>

  <h3 id="article-cta-heading" class="article-cta-title">{finalTitle}</h3>
  <p class="article-cta-text">{finalText}</p>

  <div class="article-cta-actions">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp article-btn-wa"
      data-cta="blog_article_whatsapp"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
      </svg>
      <span>Pedir Orçamento no WhatsApp</span>
    </a>

    <a href={finalCatLink} class="btn btn-secondary article-btn-sec">
      <span>{finalCatText}</span>
    </a>
  </div>
</aside>

<style>
  .article-cta-box {
    margin-block: var(--space-10);
    padding: var(--space-8);
    background-color: var(--color-paper-card);
    border: 1.5px solid var(--color-border);
    border-left: 5px solid var(--color-accent);
    border-radius: var(--radius-md);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    position: relative;
  }

  .article-cta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .article-cta-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .article-cta-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-whatsapp);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-whatsapp);
    box-shadow: 0 0 0 2px rgba(37, 211, 102, 0.3);
  }

  .article-cta-title {
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.6rem);
    font-family: var(--font-display);
    font-weight: 800;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-ink-primary);
    line-height: 1.25;
  }

  .article-cta-text {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .article-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .article-btn-wa {
    font-size: var(--text-sm);
    font-weight: 800;
    padding: 12px 22px;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .article-btn-sec {
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 12px 20px;
  }
</style>
