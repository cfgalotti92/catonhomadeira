---
interface Props {
  category: string;
  customTitle?: string;
  customText?: string;
  categoryLink?: string;
  categoryLinkText?: string;
}

const {
  category,
  customTitle,
  customText,
  categoryLink,
  categoryLinkText
} = Astro.props;

// Contextual mapping according to category
let defaultTitle = 'Vai Comprar Materiais para sua Obra ou Telhado?';
let defaultText = 'Envie sua lista de medidas, vigas, telhas ou esquadrias para a Catonho Madeiras. Nossa equipe técnica calcula os quantitativos e envia o orçamento pelo WhatsApp com frete para sua região.';
let defaultCatLink = '/madeiras/';
let defaultCatText = 'Conhecer Catálogo de Madeiras';

if (category.toLowerCase().includes('telha') || category.toLowerCase().includes('cobertura')) {
  defaultTitle = 'Planejando a Cobertura da sua Casa?';
  defaultText = 'Temos estoque completo de telhas cerâmicas capa e bica, romanas, portuguesas e esmaltadas com pronta entrega em Jacarepaguá e Zona Oeste do RJ.';
  defaultCatLink = '/telhas/';
  defaultCatText = 'Ver Modelos de Telhas';
} else if (category.toLowerCase().includes('porta') || category.toLowerCase().includes('janela') || category.toLowerCase().includes('esquadria')) {
  defaultTitle = 'Procurando Portas ou Janelas de Madeira Maciça?';
  defaultText = 'Trabalhamos com portas pivotantes, maciças e pranchetas, além de janelas coloniais e maxim-ar para pronta retirada ou entrega.';
  defaultCatLink = '/portas/';
  defaultCatText = 'Ver Portas de Madeira';
} else if (category.toLowerCase().includes('churrasqueira')) {
  defaultTitle = 'Construindo sua Área de Lazer?';
  defaultText = 'Confira nossos modelos de churrasqueiras pré-moldadas em concreto refratário e kits completos com entrega no Rio de Janeiro.';
  defaultCatLink = '/churrasqueiras/';
  defaultCatText = 'Ver Churrasqueiras Pré-Moldadas';
}

const finalTitle = customTitle || defaultTitle;
const finalText = customText || defaultText;
const finalCatLink = categoryLink || defaultCatLink;
const finalCatText = categoryLinkText || defaultCatText;

const whatsappMessage = encodeURIComponent(`Olá! Li o artigo no blog da Catonho Madeiras sobre ${category} e gostaria de solicitar um orçamento para o meu projeto.`);
const whatsappUrl = `https://wa.me/5521979011647?text=${whatsappMessage}`;
---

<div class="article-cta-box" aria-labelledby="article-cta-heading">
  <div class="article-cta-badge">Atendimento Catonho Madeiras</div>
  <h3 id="article-cta-heading" class="article-cta-title">{finalTitle}</h3>
  <p class="article-cta-text">{finalText}</p>

  <div class="article-cta-actions">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp"
      data-cta="blog_article_whatsapp"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
      </svg>
      <span>Pedir Orçamento no WhatsApp</span>
    </a>
    <a href={finalCatLink} class="btn btn-secondary">
      <span>{finalCatText}</span>
    </a>
  </div>
</div>

<style>
  .article-cta-box {
    margin-block: var(--space-10);
    padding: var(--space-8);
    background-color: var(--color-paper-subtle);
    border: 1px solid var(--color-border-strong);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .article-cta-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .article-cta-title {
    font-size: var(--text-xl);
    font-family: var(--font-display);
    margin-top: 0;
    margin-bottom: var(--space-2);
    color: var(--color-ink-primary);
  }

  .article-cta-text {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .article-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
</style>
