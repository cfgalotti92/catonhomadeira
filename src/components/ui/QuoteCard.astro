---
interface Props {
  title?: string;
  categoryDefault?: string;
}

const {
  title = 'Solicite sua Cotação Rápida',
  categoryDefault = 'Geral'
} = Astro.props;
---

<div class="quote-box" id="quote-box">
  <div class="quote-box-header">
    <div class="badge">Orçamento Ágil</div>
    <h2 class="quote-box-title">{title}</h2>
    <p class="quote-box-subtitle">
      Você pode preencher o formulário abaixo ou clicar no botão direto do WhatsApp com a sua relação de itens.
    </p>
  </div>

  <form class="quote-form" id="quote-form" onsubmit="event.preventDefault(); sendWhatsAppQuote();">
    <div class="form-row">
      <div class="form-group">
        <label for="quote-name">Seu Nome / Empresa *</label>
        <input type="text" id="quote-name" name="name" required placeholder="Ex: Carlos Construtor" class="form-input" />
      </div>
      <div class="form-group">
        <label for="quote-phone">Telefone / WhatsApp *</label>
        <input type="tel" id="quote-phone" name="phone" required placeholder="Ex: (21) 99999-9999" class="form-input" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="quote-category">Categoria Principal *</label>
        <select id="quote-category" name="category" class="form-select">
          <option value="Madeiras para Telhado / Estrutura">Madeiras (Vigas, Caibros, Ripas, Tábuas)</option>
          <option value="Telhas e Coberturas">Telhas (Capa/Bica, Romana, Esmaltada)</option>
          <option value="Portas e Janelas">Portas e Janelas de Madeira</option>
          <option value="Ferragens e Fechaduras">Ferragens e Fechaduras</option>
          <option value="Churrasqueiras">Churrasqueira Pré-Moldada</option>
          <option value="Lista Completa de Materiais" selected>Lista Completa de Materiais</option>
        </select>
      </div>
      <div class="form-group">
        <label for="quote-location">Bairro / Cidade de Entrega</label>
        <input type="text" id="quote-location" name="location" placeholder="Ex: Tanque, Jacarepaguá, RJ" class="form-input" />
      </div>
    </div>

    <div class="form-group">
      <label for="quote-items">Lista de Materiais, Medidas ou Dúvidas *</label>
      <textarea
        id="quote-items"
        name="items"
        rows="4"
        required
        placeholder="Ex: 12 vigas de maçaranduba 14x6 de 5 metros, 30 caibros 6x3,5 de 4 metros e 500 telhas romanas..."
        class="form-textarea"
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-whatsapp btn-submit-quote" id="btn-quote-submit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
        </svg>
        <span>Enviar Cotação pelo WhatsApp</span>
      </button>
      <span class="form-privacy-note">Seus dados não são compartilhados com terceiros. Atendimento humano direto.</span>
    </div>
  </form>
</div>

<script is:inline>
  function sendWhatsAppQuote() {
    const name = document.getElementById('quote-name').value;
    const phone = document.getElementById('quote-phone').value;
    const category = document.getElementById('quote-category').value;
    const location = document.getElementById('quote-location').value;
    const items = document.getElementById('quote-items').value;

    const message = `*SOLICITAÇÃO DE ORÇAMENTO — CATONHO MADEIRAS*\n\n` +
      `*Nome:* ${name}\n` +
      `*Telefone:* ${phone}\n` +
      `*Categoria:* ${category}\n` +
      (location ? `*Local de Entrega:* ${location}\n` : '') +
      `\n*Lista de Materiais / Detalhes:*\n${items}`;

    const url = `https://wa.me/5521979011647?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');
  }
</script>

<style>
  .quote-box {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 768px) {
    .quote-box {
      padding: var(--space-10);
    }
  }

  .quote-box-header {
    margin-bottom: var(--space-6);
  }

  .quote-box-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .quote-box-subtitle {
    font-size: var(--text-base);
    color: var(--color-ink-secondary);
    margin: 0;
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-primary);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 10px 14px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-primary);
    background-color: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    transition: border-color var(--transition-fast), outline var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--color-focus);
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .btn-submit-quote {
    width: 100%;
    padding: var(--space-4);
    font-size: var(--text-base);
  }

  @media (min-width: 640px) {
    .btn-submit-quote {
      width: auto;
      min-width: 320px;
    }
  }

  .form-privacy-note {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
