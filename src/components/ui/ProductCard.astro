---
interface Props {
  name: string;
  category: string;
  speciesOrMaterial?: string;
  finishOrType?: string;
  dimensions?: string;
  image: string;
  imageAlt: string;
  badge?: string;
}

const {
  name,
  category,
  speciesOrMaterial,
  finishOrType,
  dimensions,
  image,
  imageAlt,
  badge
} = Astro.props;

const encodedProduct = encodeURIComponent(`Olá! Gostaria de solicitar um orçamento para o produto: ${name} (${category}).`);
const quoteUrl = `https://wa.me/5521979011647?text=${encodedProduct}`;
---

<article class="product-card" aria-label={`Produto: ${name}`}>
  <div class="product-card-image-wrap">
    <img
      src={image}
      alt={imageAlt}
      width="400"
      height="300"
      loading="lazy"
      decoding="async"
      class="product-card-image"
    />
    {badge && <span class="badge product-card-badge">{badge}</span>}
  </div>

  <div class="product-card-body">
    <div class="product-card-meta">
      <span class="product-category">{category}</span>
    </div>

    <h3 class="product-title">{name}</h3>

    <dl class="product-specs">
      {speciesOrMaterial && (
        <div class="spec-row">
          <dt class="spec-label">Material / Espécie:</dt>
          <dd class="spec-value">{speciesOrMaterial}</dd>
        </div>
      )}
      {finishOrType && (
        <div class="spec-row">
          <dt class="spec-label">Acabamento / Tipo:</dt>
          <dd class="spec-value">{finishOrType}</dd>
        </div>
      )}
      {dimensions && (
        <div class="spec-row">
          <dt class="spec-label">Dimensões / Bitola:</dt>
          <dd class="spec-value spec-value-mono">{dimensions}</dd>
        </div>
      )}
    </dl>

    <div class="product-card-action">
      <a
        href={quoteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp btn-product-quote"
        data-product={name}
        data-cta="product_card_whatsapp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
        </svg>
        <span>Cotar no WhatsApp</span>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-strong);
  }

  .product-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-paper-muted);
    overflow: hidden;
  }

  .product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .product-card:hover .product-card-image {
    transform: scale(1.03);
  }

  .product-card-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 2;
    background-color: var(--color-paper-dark);
    color: var(--color-ink-inverse);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .product-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  .product-card-meta {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .product-category {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .product-title {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink-primary);
    line-height: var(--leading-snug);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .product-specs {
    margin: 0;
    padding: 0;
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--color-border-hairline);
    padding-top: var(--space-3);
    flex: 1;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .spec-label {
    color: var(--color-ink-muted);
    font-weight: 400;
  }

  .spec-value {
    color: var(--color-ink-primary);
    font-weight: 600;
    text-align: right;
    margin: 0;
  }

  .spec-value-mono {
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .product-card-action {
    margin-top: auto;
  }

  .btn-product-quote {
    width: 100%;
    font-size: var(--text-xs);
    padding-block: 10px;
  }
</style>
