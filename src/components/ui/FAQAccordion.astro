---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: FAQItem[];
  includeSchema?: boolean;
}

const {
  title = 'Dúvidas Frequentes',
  subtitle = 'Respostas diretas e técnicas para as principais questões sobre madeiras, telhas e entregas.',
  items,
  includeSchema = true
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="faq-section section-py" aria-labelledby="faq-title">
  <div class="container container-narrow">
    <div class="faq-header">
      <h2 id="faq-title" class="faq-heading">{title}</h2>
      {subtitle && <p class="faq-subheading">{subtitle}</p>}
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <details class="faq-item" name="faq-group">
          <summary class="faq-question">
            <span>{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

{includeSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
)}

<style>
  .faq-section {
    background-color: var(--color-paper);
  }

  .faq-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .faq-heading {
    font-size: var(--text-3xl);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .faq-subheading {
    font-size: var(--text-base);
    color: var(--color-ink-secondary);
    max-width: 600px;
    margin-inline: auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-subtle);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background-color: var(--color-paper-subtle);
    color: var(--color-accent);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5) var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: var(--leading-relaxed);
    border-top: 1px solid var(--color-border-hairline);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
  }

  .faq-answer p {
    margin: 0;
  }
</style>
