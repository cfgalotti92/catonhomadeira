---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ArticleCTA from '../components/blog/ArticleCTA.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { entry, allPosts } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  image,
  imageAlt,
  readingTime
} = entry.data;

const siteUrl = 'https://catonhomadeira.com.br';
const articleUrl = new URL(`/blog/${entry.id}/`, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

const formattedPubDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
}).format(pubDate);

const formattedUpdatedDate = updatedDate ? new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
}).format(updatedDate) : null;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": imageUrl,
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Catonho Madeiras",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "keywords": tags.join(', ')
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  pubDate={pubDate.toISOString()}
  updatedDate={updatedDate?.toISOString()}
  author={author}
>
  <Breadcrumbs
    items={[
      { label: 'Blog', href: '/blog/' },
      { label: title }
    ]}
  />

  <article class="article-page" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- Article Header -->
    <header class="article-header">
      <div class="container container-reading">
        <div class="article-meta-top">
          <span class="badge" itemprop="articleSection">{category}</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()} itemprop="datePublished" class="article-date">
            Publicado em {formattedPubDate}
          </time>
          {formattedUpdatedDate && (
            <>
              <span class="meta-dot" aria-hidden="true">·</span>
              <span class="article-updated">Atualizado em {formattedUpdatedDate}</span>
            </>
          )}
          <span class="meta-dot" aria-hidden="true">·</span>
          <span class="article-reading-time">{readingTime} de leitura</span>
        </div>

        <h1 class="article-title" itemprop="headline">{title}</h1>

        <p class="article-lead" itemprop="description">{description}</p>

        <div class="article-author-box">
          <div class="author-avatar" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="author-info">
            <span class="author-name" itemprop="author">{author}</span>
            <span class="author-role">Especialistas em Madeiras e Telhados · Estrada do Catonho</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="container container-reading article-featured-image-wrap">
      <figure class="featured-figure">
        <img
          src={image}
          alt={imageAlt}
          width="800"
          height="450"
          class="featured-image"
          itemprop="image"
        />
        <figcaption class="featured-caption">{imageAlt}</figcaption>
      </figure>
    </div>

    <!-- Article Content -->
    <div class="container container-reading">
      <div class="prose-article" itemprop="articleBody">
        <slot />
      </div>

      <!-- Contextual CTA -->
      <ArticleCTA category={category} />

      <!-- Related Posts -->
      <RelatedPosts
        currentSlug={entry.id}
        category={category}
        allPosts={allPosts}
      />
    </div>
  </article>

  <!-- Article JSON-LD Schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

<style>
  .article-page {
    padding-bottom: var(--space-16);
  }

  .article-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .article-meta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-4);
  }

  .meta-dot {
    color: var(--color-border-strong);
  }

  .article-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin-top: 0;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: var(--text-4xl);
    }
  }

  .article-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-secondary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-6);
  }

  .article-author-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-hairline);
  }

  .author-avatar {
    width: 36px;
    height: 36px;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    font-size: var(--text-xs);
  }

  .author-name {
    font-weight: 600;
    color: var(--color-ink-primary);
  }

  .author-role {
    color: var(--color-ink-muted);
  }

  .article-featured-image-wrap {
    margin-bottom: var(--space-8);
  }

  .featured-figure {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-paper-muted);
    border: 1px solid var(--color-border);
  }

  .featured-image {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
  }

  .featured-caption {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-paper-subtle);
    font-style: normal;
  }

  /* Prose Article Styles */
  .prose-article {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-primary);
  }

  .prose-article :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .prose-article :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }

  .prose-article :global(p) {
    margin-bottom: var(--space-5);
    color: var(--color-ink-secondary);
  }

  .prose-article :global(ul), .prose-article :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .prose-article :global(li) {
    margin-bottom: var(--space-2);
    color: var(--color-ink-secondary);
  }

  .prose-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-8);
    font-size: var(--text-sm);
  }

  .prose-article :global(th), .prose-article :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .prose-article :global(th) {
    background-color: var(--color-paper-subtle);
    color: var(--color-ink-primary);
    font-weight: 600;
  }

  .prose-article :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-5);
    margin-block: var(--space-6);
    font-style: normal;
    color: var(--color-ink-secondary);
    background-color: var(--color-paper-subtle);
    padding-block: var(--space-3);
    padding-right: var(--space-4);
  }
</style>
