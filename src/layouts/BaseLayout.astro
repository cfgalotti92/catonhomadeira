---
import SEOHead from '../components/seo/SEOHead.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  pubDate,
  updatedDate,
  author,
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager: container supplied by the site owner -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KM3P3PK9');
    </script>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      author={author}
      noindex={noindex}
    />
    <SchemaLocalBusiness />
    <!-- Preconnect for performance -->
    <link rel="dns-prefetch" href="https://wa.me" />
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KM3P3PK9"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

    <!-- Header Navigation -->
    <Header currentPath={currentPath} />

    <!-- Main Content Slot -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Mobile Navigation Drawer -->
    <MobileNav currentPath={currentPath} />

    <!-- Floating WhatsApp Action for Fast Contact (Mobile & Desktop) -->
    <a
      href="https://wa.me/5521979011647?text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento%20de%20madeiras%20e%20materiais."
      target="_blank"
      rel="noopener noreferrer"
      class="floating-whatsapp-btn"
      aria-label="Falar com atendente no WhatsApp"
      data-cta="floating_whatsapp"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.777.781 2.796.782 3.185 0 5.77-2.587 5.77-5.768 0-3.181-2.587-5.766-5.77-5.766zm3.376 8.204c-.149.42-1.077.839-1.488.882-.412.043-1.066.079-2.888-1.008-1.503-.896-2.482-2.735-2.557-2.859-.074-.124-.613-.815-.613-1.554 0-.739.387-1.103.525-1.252.137-.149.301-.186.401-.186.1 0 .2.001.288.006.094.005.219-.036.344.263.125.299.425 1.036.463 1.111.037.075.062.162.012.261-.05.1-.075.162-.15.249-.075.087-.157.195-.224.263-.075.074-.153.155-.066.304.087.149.389.641.834 1.038.572.51 1.054.667 1.203.742.149.075.237.062.325-.038.087-.099.375-.436.475-.585.1-.149.2-.124.337-.075.137.05.874.412 1.024.487.15.075.25.112.287.174.037.062.037.362-.112.782z"/>
      </svg>
      <span class="floating-tooltip">Orçamento no WhatsApp</span>
    </a>

    <style>
      main:focus {
        outline: none;
      }

      .floating-whatsapp-btn {
        position: fixed;
        bottom: var(--space-6);
        right: var(--space-6);
        z-index: 99;
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: 12px;
        background-color: var(--color-whatsapp);
        color: #fff;
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-hover);
        text-decoration: none;
        transition: transform var(--transition-fast), background-color var(--transition-fast);
      }

      .floating-whatsapp-btn:hover {
        background-color: var(--color-whatsapp-hover);
        transform: scale(1.06);
      }

      .floating-whatsapp-btn:focus-visible {
        outline: 3px solid var(--color-whatsapp);
        outline-offset: 3px;
      }

      .floating-tooltip {
        display: none;
        font-size: var(--text-xs);
        font-weight: 600;
        padding-right: 6px;
      }

      @media (min-width: 768px) {
        .floating-tooltip {
          display: inline;
        }
      }
    </style>
  </body>
</html>
